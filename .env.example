# Backend server
PORT=4000

# Set this to your Vercel frontend URL on Render
FRONTEND_URL=https://prompt-war-six.vercel.app

# Feedback storage mode: postgres or csv
FEEDBACK_STORAGE=postgres

# Default/fallback PostgreSQL URL
DATABASE_URL=postgresql://postgres:Abhi%401234@localhost:5432/localfeedback

# Local development database
LOCAL_DATABASE_URL=postgresql://postgres:Abhi%401234@localhost:5432/localfeedback

# Online/production database
ONLINE_DATABASE_URL=postgresql://postgres:Abhi%401234@localhost:5432/onlinefeedback

# Set true for managed Postgres services that require SSL
PGSSL=false

# (Optional) HuggingFace token for higher image generation rate limits.
# Anonymous requests work without this — get a free token at huggingface.co
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx
